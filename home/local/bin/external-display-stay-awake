#!/bin/sh
# Keep the machine awake while an external display or external power is present.
#
# systemd-logind continuously rechecks a closed lid and only treats an external
# display as docked while its DRM connector is enabled. The KVM can report DP-3
# disconnected long enough for a display-only inhibitor to be released even
# though the laptop remains plugged into AC. External power is the stable signal;
# the display check also covers externally driven setups that are not charging.

POLL_INTERVAL=${EXTERNAL_DISPLAY_STAY_AWAKE_INTERVAL:-1}
POWER_SUPPLY_PATH=${EXTERNAL_DISPLAY_STAY_AWAKE_POWER_SUPPLY_PATH:-/sys/class/power_supply}
RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/external-display-stay-awake-$(id -u)}
LOCK_FILE=$RUNTIME_DIR/external-display-stay-awake.lock
INHIBITOR_PID=

for command_name in flock omarchy systemd-inhibit; do
  command -v "$command_name" >/dev/null 2>&1 || exit 0
done

mkdir -p "$RUNTIME_DIR"
exec 9>"$LOCK_FILE"
flock -n 9 || exit 0

inhibitor_running() {
  [ -n "$INHIBITOR_PID" ] && kill -0 "$INHIBITOR_PID" 2>/dev/null
}

external_power_online() {
  for power_supply in "$POWER_SUPPLY_PATH"/*; do
    [ -r "$power_supply/type" ] && [ -r "$power_supply/online" ] || continue

    IFS= read -r power_type <"$power_supply/type"
    [ "$power_type" = "Battery" ] && continue

    IFS= read -r online <"$power_supply/online"
    [ "$online" = "1" ] && return 0
  done

  return 1
}

start_inhibitor() {
  inhibitor_running && return

  if [ -n "$INHIBITOR_PID" ]; then
    wait "$INHIBITOR_PID" 2>/dev/null || true
  fi

  systemd-inhibit \
    --what=sleep:handle-lid-switch \
    --mode=block \
    --who="Plugged in" \
    --why="Keep the laptop awake while external display or power is connected" \
    sleep infinity &
  INHIBITOR_PID=$!
}

stop_inhibitor() {
  if inhibitor_running; then
    kill "$INHIBITOR_PID" 2>/dev/null || true
    wait "$INHIBITOR_PID" 2>/dev/null || true
  fi
  INHIBITOR_PID=
}

trap 'exit 0' HUP INT TERM
trap stop_inhibitor EXIT

while :; do
  if external_power_online || omarchy hw external monitors >/dev/null 2>&1; then
    start_inhibitor
  else
    stop_inhibitor
  fi
  sleep "$POLL_INTERVAL"
done
