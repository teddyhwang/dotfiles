#!/usr/bin/env node
// Give every pane in a Herdr tab an equal share, like tmux's select-layout even-*.
//
// Herdr has no even-layout action and no CLI for split ratios, so this talks to
// the socket API directly: layout.export to read the split tree, then
// layout.set_split_ratio per split node. Each node's ratio becomes
// leaves(first) / leaves(node), which makes every leaf the same size whatever
// the nesting looks like.
import { connect } from "node:net";
import { homedir } from "node:os";

const SOCKET = process.env.HERDR_SOCKET_PATH ?? `${homedir()}/.config/herdr/herdr.sock`;
const MAX_RESPONSE_BYTES = 1024 * 1024;

function fail(message) {
  console.error(`herdr-even-layout: ${message}`);
  process.exit(1);
}

let timeoutMs;
{
  const raw = process.env.HERDR_SOCKET_TIMEOUT ?? "2";
  const seconds = /^\s*[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?\s*$/.test(raw) ? Number(raw) : NaN;
  if (!(seconds > 0)) fail("HERDR_SOCKET_TIMEOUT must be positive");
  timeoutMs = seconds * 1000;
}

// One request per connection; the reply is a single newline-terminated line.
function exchange(request) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    let size = 0;
    const client = connect(SOCKET);
    client.setTimeout(timeoutMs);
    client.on("timeout", () => client.destroy(new Error("timed out")));
    client.on("error", reject);
    client.on("connect", () => client.write(`${JSON.stringify(request)}\n`));
    client.on("data", (chunk) => {
      chunks.push(chunk);
      size += chunk.length;
      if (size > MAX_RESPONSE_BYTES) {
        client.destroy(new Error("response exceeded 1 MiB"));
      } else if (chunk[chunk.length - 1] === 0x0a) {
        client.destroy();
        resolve(Buffer.concat(chunks));
      }
    });
    client.on("end", () => reject(new Error("incomplete response")));
  });
}

async function call(method, params) {
  let reply;
  try {
    const buf = await exchange({ id: "even", method, params });
    const text = new TextDecoder("utf-8", { fatal: true }).decode(buf);
    reply = JSON.parse(text.split(/\r\n|[\n\r\v\f\x1c-\x1e\x85\u2028\u2029]/)[0]);
  } catch (error) {
    fail(error.message);
  }

  if (reply !== null && typeof reply === "object" && "error" in reply) {
    const error = reply.error;
    fail(error !== null && typeof error === "object" ? (error.message ?? error) : error);
  }
  if (reply === null || typeof reply !== "object" || !("result" in reply)) {
    fail("response did not contain a result");
  }
  return reply.result;
}

function leaves(node) {
  if (node.type === "pane") return 1;
  return leaves(node.first) + leaves(node.second);
}

// Collect [path, ratio] for every split, deepest last.
function plan(node, path, out) {
  if (node.type === "pane") return;
  const { first, second } = node;
  out.push([path, leaves(first) / (leaves(first) + leaves(second))]);
  plan(first, [...path, false], out);
  plan(second, [...path, true], out);
}

async function main() {
  const params = {};
  const tabId = process.env.HERDR_ACTIVE_TAB_ID;
  if (tabId) params.tab_id = tabId;

  const root = (await call("layout.export", params)).layout.root;
  if (root.type === "pane") return; // single pane, nothing to even out

  const changes = [];
  plan(root, [], changes);
  for (const [path, ratio] of changes) {
    await call("layout.set_split_ratio", { ...params, path, ratio });
  }

  if (process.argv.includes("--verbose")) {
    for (const [path, ratio] of changes) {
      const shown = path.map((second) => (second ? "True" : "False")).join(", ");
      console.log(`path=[${shown}] ratio=${ratio.toFixed(4)}`);
    }
  }
}

await main();
