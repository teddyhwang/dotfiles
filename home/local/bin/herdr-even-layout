#!/usr/bin/env python3
"""Give every pane in a Herdr tab an equal share, like tmux's select-layout even-*.

Herdr has no even-layout action and no CLI for split ratios, so this talks to
the socket API directly: layout.export to read the split tree, then
layout.set_split_ratio per split node. Each node's ratio becomes
leaves(first) / leaves(node), which makes every leaf the same size whatever
the nesting looks like.
"""
import json
import os
import socket
import sys

SOCKET = os.environ.get(
    "HERDR_SOCKET_PATH", os.path.expanduser("~/.config/herdr/herdr.sock")
)
try:
    TIMEOUT_SECONDS = float(os.environ.get("HERDR_SOCKET_TIMEOUT", "2"))
    if TIMEOUT_SECONDS <= 0:
        raise ValueError
except ValueError:
    raise SystemExit("herdr-even-layout: HERDR_SOCKET_TIMEOUT must be positive") from None
MAX_RESPONSE_BYTES = 1024 * 1024


def call(method, params):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(TIMEOUT_SECONDS)
            s.connect(SOCKET)
            request = {"id": "even", "method": method, "params": params}
            s.sendall((json.dumps(request) + "\n").encode())
            buf = b""
            while not buf.endswith(b"\n"):
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
                if len(buf) > MAX_RESPONSE_BYTES:
                    raise ValueError("response exceeded 1 MiB")

        if not buf.endswith(b"\n"):
            raise ValueError("incomplete response")
        reply = json.loads(buf.decode().splitlines()[0])
    except (OSError, UnicodeError, ValueError, json.JSONDecodeError) as error:
        raise SystemExit(f"herdr-even-layout: {error}") from error

    if "error" in reply:
        error = reply["error"]
        message = error.get("message", error) if isinstance(error, dict) else error
        raise SystemExit(f"herdr-even-layout: {message}")
    if "result" not in reply:
        raise SystemExit("herdr-even-layout: response did not contain a result")
    return reply["result"]


def leaves(node):
    if node.get("type") == "pane":
        return 1
    return leaves(node["first"]) + leaves(node["second"])


def plan(node, path, out):
    """Collect (path, ratio) for every split, deepest last."""
    if node.get("type") == "pane":
        return
    first, second = node["first"], node["second"]
    out.append((path, leaves(first) / (leaves(first) + leaves(second))))
    plan(first, path + [False], out)
    plan(second, path + [True], out)


def main():
    params = {}
    tab_id = os.environ.get("HERDR_ACTIVE_TAB_ID")
    if tab_id:
        params["tab_id"] = tab_id

    root = call("layout.export", params)["layout"]["root"]
    if root.get("type") == "pane":
        return  # single pane, nothing to even out

    changes = []
    plan(root, [], changes)
    for path, ratio in changes:
        call("layout.set_split_ratio", dict(params, path=path, ratio=ratio))

    if "--verbose" in sys.argv:
        for path, ratio in changes:
            print(f"path={path} ratio={ratio:.4f}")


if __name__ == "__main__":
    main()
