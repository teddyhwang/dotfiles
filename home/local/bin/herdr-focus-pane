#!/usr/bin/env node
// Focus an exact Herdr pane through the raw socket API.
import { connect } from "node:net";
import { homedir } from "node:os";
import path from "node:path";

function socketPath() {
  const configured = process.env.HERDR_SOCKET_PATH;
  if (configured) return configured;

  const configHome = process.env.XDG_CONFIG_HOME ?? path.join(homedir(), ".config");
  const session = process.env.HERDR_SESSION;
  if (session && session !== "default") {
    return path.join(configHome, "herdr", "sessions", session, "herdr.sock");
  }
  return path.join(configHome, "herdr", "herdr.sock");
}

// Send one request and resolve with the first line the socket returns (or
// whatever arrived before EOF).
function exchange(request) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    const client = connect(socketPath());
    client.setTimeout(5000);
    client.on("timeout", () => client.destroy(new Error("timed out")));
    client.on("error", reject);
    client.on("connect", () => client.write(`${JSON.stringify(request)}\n`));
    client.on("end", () => resolve(Buffer.concat(chunks)));
    client.on("data", (chunk) => {
      chunks.push(chunk);
      if (chunk.includes(0x0a)) {
        client.destroy();
        resolve(Buffer.concat(chunks));
      }
    });
  });
}

async function main() {
  if (process.argv.length !== 3) {
    console.error("usage: herdr-focus-pane PANE_ID");
    return 2;
  }

  const requestId = `dotfiles:pane-focus:${process.pid}`;
  const request = {
    id: requestId,
    method: "pane.focus",
    params: { pane_id: process.argv[2] },
  };

  try {
    const buf = await exchange(request);
    const newline = buf.indexOf(0x0a);
    const responseLine = newline === -1 ? buf : buf.subarray(0, newline + 1);
    if (responseLine.length === 0) {
      throw new Error("Herdr closed the socket without a response");
    }
    const response = JSON.parse(responseLine.toString());
    if (response?.id !== requestId) {
      throw new Error("Herdr returned a response with the wrong request ID");
    }
    if ("error" in response) {
      const error = response.error;
      throw new Error(error?.message || error?.code || "pane focus failed");
    }
  } catch (error) {
    console.error(`herdr-focus-pane: ${error.message}`);
    return 1;
  }

  return 0;
}

process.exitCode = await main();
