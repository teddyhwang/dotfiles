#!/usr/bin/env python3
"""Name Herdr tabs after whatever the tab is actually doing.

Herdr labels new tabs "1", "2", "3" and never revisits that, so a workspace of
agent sessions reads as a row of numbers. Agents already publish a better name:
Claude writes the conversation topic into the terminal title, which Herdr
surfaces as the pane's terminal_title_stripped. This daemon watches the socket
API and copies that into the tab label, falling back to repo + branch for panes
whose title says nothing useful (pi writes "π - dotfiles", plain shells write
whatever the prompt sets).

Ownership rules, so this never fights the user:
  - a tab is auto-named only while its label is Herdr's generated number or the
    last label this daemon assigned;
  - renaming a tab by hand (prefix+A) opts it out for good;
  - renaming it back to its number opts it back in.

Run it as a login daemon: hypr/autostart.lua on Linux, the launch agent in
apps/herdr-tab-autoname.plist on macOS. It waits for the Herdr server to
appear, follows every session socket it finds, and reconnects when a server
restarts, so starting it before Herdr exists is fine on either platform.
"""

from __future__ import annotations

import argparse
import errno
import fcntl
import json
import os
import select
import socket
import subprocess
import sys
import time

# Herdr writes its sockets beside config.toml. herdr.sock is the default
# session; named sessions (herdr --session foo) add their own. The client
# socket speaks a different protocol, so it is excluded.
CONFIG_DIRS = [
    os.path.expanduser(path)
    for path in (
        os.environ.get("HERDR_CONFIG_DIR"),
        "~/.config/herdr",
        "~/Library/Application Support/herdr",
    )
    if path
]
CLIENT_SOCKET_SUFFIX = "-client.sock"

MAX_LABEL = 32

# Branch display follows the prompt in home/.p10k.zsh: the Nerd Font branch
# glyph, and nothing at all on the trunk, where the branch says nothing.
BRANCH_GLYPH = ""
BRANCH_IMPLIED = {"main", "master"}

# Titles that name the agent instead of the work. Compared after stripping the
# status glyph Claude and friends prepend.
GENERIC_TITLES = {
    "claude",
    "claude code",
    "codex",
    "cursor",
    "droid",
    "gemini",
    "opencode",
    "pi",
    "shell",
    "terminal",
    "zsh",
    "bash",
    "fish",
    "sh",
}

TITLE_SEPARATORS = (" - ", " — ", " – ", ": ", " | ", " • ")

# Coalescing window for bursts of pane updates, and the floor between renames
# of the same tab, so a title that flickers cannot spam the server.
SETTLE_SECONDS = 0.75
RENAME_INTERVAL = 2.0
RECONNECT_SECONDS = 2.0
RESCAN_SECONDS = 3.0
GIT_CACHE_SECONDS = 15.0

SUBSCRIPTIONS = [
    {"type": "tab.created"},
    {"type": "tab.closed"},
    {"type": "tab.renamed"},
    {"type": "tab.moved"},
    {"type": "pane.created"},
    {"type": "pane.closed"},
    {"type": "pane.exited"},
    {"type": "pane.moved"},
    {"type": "pane.updated"},
    {"type": "pane.agent_detected"},
]

# pane.updated fires on every screen revision. Only these fields can change the
# label, so everything else is dropped before it costs a snapshot.
PANE_SIGNATURE_FIELDS = ("tab_id", "terminal_title_stripped", "cwd", "agent")


def log(message: str) -> None:
    if VERBOSE:
        print(f"herdr-tab-autoname: {message}", file=sys.stderr, flush=True)


def truncate(label: str) -> str:
    if len(label) <= MAX_LABEL:
        return label
    cut = label[: MAX_LABEL - 1]
    if not label[MAX_LABEL - 1].isspace():
        # The cut landed mid-word. Back up to the last boundary, unless that
        # throws away most of the label.
        space = cut.rfind(" ")
        if space >= MAX_LABEL // 2:
            cut = cut[:space]
    return cut.rstrip(" -—–:|") + "…"


class GitCache:
    """git lookups keyed by cwd. Branches change; the answers expire."""

    def __init__(self) -> None:
        self._entries: dict[str, tuple[float, tuple[str | None, str | None]]] = {}

    def describe(self, cwd: str) -> tuple[str | None, str | None]:
        """Return (repo root, branch or short sha) for cwd, or (None, None)."""
        now = time.monotonic()
        cached = self._entries.get(cwd)
        if cached and now - cached[0] < GIT_CACHE_SECONDS:
            return cached[1]

        result = (self._run(cwd, "rev-parse", "--show-toplevel"), self._branch(cwd))
        self._entries[cwd] = (now, result)
        return result

    def forget_missing(self, live_cwds: set[str]) -> None:
        for cwd in list(self._entries):
            if cwd not in live_cwds:
                del self._entries[cwd]

    def _branch(self, cwd: str) -> str | None:
        branch = self._run(cwd, "symbolic-ref", "--quiet", "--short", "HEAD")
        if branch:
            return branch
        # Detached HEAD (bisect, rebase, checked-out tag): the sha still tells
        # you where you are.
        return self._run(cwd, "rev-parse", "--short", "HEAD")

    @staticmethod
    def _run(cwd: str, *args: str) -> str | None:
        try:
            done = subprocess.run(
                ("git", "-C", cwd, *args),
                capture_output=True,
                text=True,
                timeout=2,
            )
        except (OSError, subprocess.SubprocessError):
            return None
        if done.returncode != 0:
            return None
        value = done.stdout.strip()
        return value or None


class Session:
    """The event stream of one Herdr server, plus the state it drives.

    A subscribed connection is a one-way stream: the server resets it if
    anything else is sent down it, so snapshots and renames each get their own
    short-lived connection.
    """

    def __init__(self, path: str, git: GitCache) -> None:
        self.path = path
        self.git = git
        self.events = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.events.settimeout(2)
        self.events.connect(path)
        self.events.sendall(
            json.dumps(
                {
                    "id": "tab-autoname:subscribe",
                    "method": "events.subscribe",
                    "params": {"subscriptions": SUBSCRIPTIONS},
                }
            ).encode()
            + b"\n"
        )
        self.events.settimeout(None)
        self.buffer = b""
        self.settle_deadline: float | None = None
        # tab_id -> label this daemon assigned. A label that is neither this nor
        # the tab's number means the user renamed the tab by hand.
        self.assigned: dict[str, str] = {}
        self.renamed_at: dict[str, float] = {}
        self.pane_signatures: dict[str, tuple] = {}
        self.sync()

    def fileno(self) -> int:
        return self.events.fileno()

    def close(self) -> None:
        try:
            self.events.close()
        except OSError:
            pass

    def call(self, method: str, params: dict) -> dict | None:
        """Round-trip one request on its own connection."""
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.settimeout(2)
                sock.connect(self.path)
                request = {"id": "tab-autoname", "method": method, "params": params}
                sock.sendall(json.dumps(request).encode() + b"\n")
                buffer = b""
                while b"\n" not in buffer:
                    chunk = sock.recv(65536)
                    if not chunk:
                        return None
                    buffer += chunk
                return json.loads(buffer.split(b"\n", 1)[0])
        except (OSError, ValueError) as exc:
            log(f"{method} failed: {exc}")
            return None

    def sync(self) -> None:
        self.settle_deadline = None
        response = self.call("session.snapshot", {})
        snapshot = ((response or {}).get("result") or {}).get("snapshot")
        if not snapshot:
            return
        try:
            self.apply(snapshot)
        except Exception as exc:  # a surprise in one snapshot must not end the daemon
            log(f"snapshot ignored: {exc!r}")

    def mark_dirty(self) -> None:
        if self.settle_deadline is None:
            self.settle_deadline = time.monotonic() + SETTLE_SECONDS

    def tick(self) -> None:
        """Take a snapshot once the burst of events has settled."""
        if self.settle_deadline is not None and time.monotonic() >= self.settle_deadline:
            self.sync()

    def timeout(self) -> float | None:
        if self.settle_deadline is None:
            return None
        return max(0.0, self.settle_deadline - time.monotonic())

    def read(self) -> bool:
        """Drain the event stream. Returns False when the server hangs up."""
        try:
            chunk = self.events.recv(65536)
        except OSError as exc:
            if exc.errno == errno.EINTR:
                return True
            return False
        if not chunk:
            return False

        self.buffer += chunk
        while b"\n" in self.buffer:
            line, self.buffer = self.buffer.split(b"\n", 1)
            if not line.strip():
                continue
            try:
                message = json.loads(line)
            except ValueError:
                continue
            if "event" in message:
                self.handle_event(message.get("data") or {})
        return True

    def handle_event(self, data: dict) -> None:
        kind = data.get("type")
        if kind == "pane_updated":
            pane = data.get("pane") or {}
            pane_id = pane.get("pane_id")
            if not pane_id:
                return
            signature = tuple(pane.get(field) for field in PANE_SIGNATURE_FIELDS)
            if self.pane_signatures.get(pane_id) == signature:
                return
            self.pane_signatures[pane_id] = signature
        self.mark_dirty()

    def apply(self, snapshot: dict) -> None:
        tabs = snapshot.get("tabs") or []
        panes = snapshot.get("panes") or []

        panes_by_tab: dict[str, list[dict]] = {}
        for pane in panes:
            panes_by_tab.setdefault(pane.get("tab_id"), []).append(pane)

        live_tabs = set()
        for tab in tabs:
            tab_id = tab.get("tab_id")
            if not tab_id:
                continue
            live_tabs.add(tab_id)
            self.consider(tab, panes_by_tab.get(tab_id, []))

        for tab_id in list(self.assigned):
            if tab_id not in live_tabs:
                del self.assigned[tab_id]
                self.renamed_at.pop(tab_id, None)
        live_panes = {pane.get("pane_id") for pane in panes}
        for pane_id in list(self.pane_signatures):
            if pane_id not in live_panes:
                del self.pane_signatures[pane_id]
        self.git.forget_missing({pane.get("cwd") for pane in panes if pane.get("cwd")})

    def consider(self, tab: dict, panes: list[dict]) -> None:
        tab_id = tab["tab_id"]
        label = tab.get("label") or ""

        # Herdr generates the label from the tab's position at creation, which
        # need not match tab.number once earlier tabs close, so any all-digit
        # label counts as unclaimed. The Pi session-name extension can win the
        # race with this daemon and rename the tab directly; adopt that exact
        # terminal-title-derived label instead of mistaking it for a hand edit.
        if label and not label.isdigit() and label != self.assigned.get(tab_id):
            pi_label = pi_session_label_for(panes)
            if label == pi_label:
                self.assigned[tab_id] = label
                log(f"{tab_id}: adopted Pi session label {label!r}")
                return

            # Named by hand. Forget our claim so it stays named by hand.
            if self.assigned.pop(tab_id, None) is not None:
                log(f"{tab_id} renamed by hand to {label!r}; leaving it alone")
            return

        desired = self.label_for(panes)
        if not desired or desired == label:
            return

        now = time.monotonic()
        if now - self.renamed_at.get(tab_id, 0.0) < RENAME_INTERVAL:
            self.mark_dirty()
            return

        log(f"{tab_id}: {label!r} -> {desired!r}{' [dry-run]' if DRY_RUN else ''}")
        if not DRY_RUN:
            self.call("tab.rename", {"tab_id": tab_id, "label": desired})
        self.assigned[tab_id] = desired
        self.renamed_at[tab_id] = now

    def label_for(self, panes: list[dict]) -> str | None:
        if not panes:
            return None

        ordered = sorted(panes, key=pane_order)
        pi_label = pi_session_label_for(ordered)
        if pi_label:
            return pi_label

        for pane in ordered:
            if not pane.get("agent"):
                continue
            topic = topic_from_title(pane)
            if topic:
                return truncate(topic)

        cwd = next((pane.get("cwd") for pane in ordered if pane.get("cwd")), None)
        return truncate(self.project_label(cwd)) if cwd else None

    def project_label(self, cwd: str) -> str:
        root, branch = self.git.describe(cwd)
        home = os.path.expanduser("~")
        name = os.path.basename(root or cwd.rstrip("/")) or "/"
        if not root and os.path.normpath(cwd) == os.path.normpath(home):
            name = "~"
        if not branch or branch in BRANCH_IMPLIED:
            return name
        return f"{name} {BRANCH_GLYPH} {branch}"


def pane_order(pane: dict) -> tuple:
    """Sort panes by their numeric suffix so the label does not follow focus."""
    pane_id = pane.get("pane_id") or ""
    _, _, tail = pane_id.rpartition(":p")
    try:
        return (0, int(tail))
    except ValueError:
        return (1, pane_id)


def pi_session_name_from_title(pane: dict) -> str | None:
    """Extract NAME from Pi's terminal title: ``π - NAME - cwd``."""
    title = pane.get("terminal_title_stripped") or pane.get("terminal_title") or ""
    title = " ".join(title.split())
    cwd = pane.get("cwd") or ""
    basename = os.path.basename(cwd.rstrip("/"))
    prefix = "π - "
    suffix = f" - {basename}"
    if not basename or not title.startswith(prefix):
        return None
    if not title.casefold().endswith(suffix.casefold()):
        return None
    name = title[len(prefix) : len(title) - len(suffix)].strip()
    return name or None


def pi_session_label_for(panes: list[dict]) -> str | None:
    """Return the first explicit Pi session name, formatted as a tab label."""
    for pane in sorted(panes, key=pane_order):
        if pane.get("agent") != "pi":
            continue
        name = pi_session_name_from_title(pane)
        if name:
            return truncate(name)
    return None


def topic_from_title(pane: dict) -> str | None:
    """The work the agent reports, or None when the title only names the agent."""
    title = pane.get("terminal_title_stripped") or pane.get("terminal_title") or ""
    # Agents prefix a spinner or status glyph: "◐ ", "✳ ", "✻ ". Drop leading
    # symbols, but keep letters, so pi's generic "π - dotfiles" can still be
    # rejected as a restatement of the location below.
    while title and not (title[0].isalnum() or title[0] in "\"'#"):
        title = title[1:]
    title = " ".join(title.split())
    if not title:
        return None

    folded = title.casefold()
    if folded in GENERIC_TITLES:
        return None
    agent = (pane.get("agent") or "").casefold()
    if agent and folded == agent:
        return None

    cwd = pane.get("cwd") or ""
    basename = os.path.basename(cwd.rstrip("/")).casefold()
    parts = [title]
    for separator in TITLE_SEPARATORS:
        if separator in title:
            parts = [part.strip() for part in title.split(separator)]
            break

    for part in parts:
        folded_part = part.casefold()
        # "π - dotfiles", "zsh: ~/src/dotfiles" and friends restate the
        # location, which the project fallback says better.
        if basename and folded_part == basename:
            return None
        if folded_part in GENERIC_TITLES:
            return None
        if "/" in part or part.startswith("~"):
            return None

    return title


def session_sockets() -> list[str]:
    override = os.environ.get("HERDR_SOCKET_PATH")
    if override:
        return [override] if os.path.exists(override) else []

    found: list[str] = []
    for directory in CONFIG_DIRS:
        try:
            names = os.listdir(directory)
        except OSError:
            continue
        found.extend(
            os.path.join(directory, name)
            for name in names
            if name.endswith(".sock") and not name.endswith(CLIENT_SOCKET_SUFFIX)
        )
    return sorted(found)


def claim_singleton() -> bool:
    """Take an exclusive lock so a second daemon bows out.

    flock is released when the process dies, so a crash or a logout leaves
    nothing to clean up. The descriptor is parked in a global because closing
    it — including letting it fall out of scope — releases the lock.
    """
    global SINGLETON_LOCK
    # Not XDG_RUNTIME_DIR or TMPDIR: those differ between a login agent and a
    # terminal on macOS, which would let a second daemon take a second lock.
    cache_dir = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    path = os.path.join(cache_dir, "herdr-tab-autoname.lock")
    try:
        os.makedirs(cache_dir, exist_ok=True)
        fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    except OSError as exc:
        log(f"cannot open {path}: {exc}")
        return True  # An unlockable lock file is no reason to refuse to run.
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return False
    SINGLETON_LOCK = fd
    return True


def run(once: bool) -> int:
    sessions: dict[str, Session] = {}
    next_scan = 0.0

    while True:
        now = time.monotonic()
        if now >= next_scan:
            next_scan = now + RESCAN_SECONDS
            paths = set(session_sockets())
            for path in list(sessions):
                if path not in paths:
                    sessions.pop(path).close()
            for path in paths - set(sessions):
                try:
                    sessions[path] = Session(path, GIT_CACHE)
                    log(f"following {path}")
                except OSError as exc:
                    log(f"cannot follow {path}: {exc}")

        if once and not sessions:
            log("no Herdr server running")
            return 1

        if once:
            # Connecting already synced every session once.
            for session in sessions.values():
                session.close()
            return 0

        timeout = RECONNECT_SECONDS
        for session in sessions.values():
            session_timeout = session.timeout()
            if session_timeout is not None:
                timeout = min(timeout, session_timeout)

        readable: list[Session] = []
        if sessions:
            try:
                readable, _, _ = select.select(list(sessions.values()), [], [], timeout)
            except OSError:
                readable = []
        else:
            time.sleep(timeout)

        for session in readable:
            if not session.read():
                log(f"{session.path} closed")
                session.close()
                sessions.pop(session.path, None)
                next_scan = 0.0

        for session in list(sessions.values()):
            session.tick()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--once",
        action="store_true",
        help="apply names once and exit instead of following events",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="log the renames without sending them",
    )
    parser.add_argument("-v", "--verbose", action="store_true", help="log to stderr")
    args = parser.parse_args()

    global VERBOSE, DRY_RUN
    VERBOSE = args.verbose or args.dry_run
    DRY_RUN = args.dry_run

    # A one-shot pass is read-mostly and safe to run beside the daemon.
    if not args.once and not claim_singleton():
        log("another herdr-tab-autoname is already running")
        return 0

    try:
        return run(args.once)
    except KeyboardInterrupt:
        return 0


VERBOSE = False
DRY_RUN = False
SINGLETON_LOCK: int | None = None
GIT_CACHE = GitCache()

if __name__ == "__main__":
    sys.exit(main())
