#!/usr/bin/env node
// Install the tinty-generated Zed theme so Zed matches Neovim.
//
// tinty names the generated theme after the scheme ("Base16 Seti UI"), so a
// fixed `theme` in Zed's settings would stop following `tinty apply`. This hook
// installs it under one stable name, "Tinted Theming", which settings.json
// selects. Zed watches its themes directory and reloads the theme on change.
//
// It also applies the highlight overrides from Neovim's
// home/config/nvim/lua/config/colorscheme.lua (and the indent opacity from
// lua/util/indent-opacity.lua), computed from the applied scheme's palette, so
// both editors render the same colors.
//
// Usage: tinty-zed-hook THEME_FILE
// The palette comes from tinty's TINTY_SCHEME_PALETTE_BASExx_HEX_{R,G,B}
// variables. tinty runs this for every new shell (`tinty init`), so the theme
// file is only rewritten when its content changes.

import {
  chmodSync,
  closeSync,
  mkdirSync,
  openSync,
  readFileSync,
  renameSync,
  lstatSync,
  statSync,
  unlinkSync,
  writeSync,
} from "node:fs";
import { randomBytes } from "node:crypto";
import path from "node:path";

const THEME_NAME = "Tinted Theming";
const THEME_FILE_NAME = "tinted-theming.json";
// Written by the previous hook (`cp -f "$TINTY_THEME_FILE_PATH" ...`).
const LEGACY_THEME_FILE_NAME = "tinted-zed-themes-file.json";
const BASES = [..."0123456789ABCDEF"].map((digit) => `base0${digit}`);

function paletteFromEnv(env) {
  const palette = {};
  for (const base of BASES) {
    const channels = [..."RGB"].map((c) => env[`TINTY_SCHEME_PALETTE_${base.toUpperCase()}_HEX_${c}`] ?? "");
    if (!channels.every((channel) => /^[0-9a-fA-F]{2}$/.test(channel))) return null;
    palette[base] = `#${channels.join("").toLowerCase()}`;
  }
  return palette;
}

function rgb(color) {
  color = color.replace(/^#+/, "");
  return [0, 2, 4].map((index) => Number.parseInt(color.slice(index, index + 2), 16));
}

// Same blend as blend_colors() in Neovim's colorscheme.lua.
function blend(foreground, background, alpha) {
  const bgChannels = rgb(background);
  const mixed = rgb(foreground).map((fg, index) => Math.trunc(fg * alpha + bgChannels[index] * (1 - alpha)));
  return `#${mixed.map((channel) => channel.toString(16).padStart(2, "0")).join("")}`;
}

const opaque = (color) => `${color}ff`;

function isLight(palette) {
  const [red, green, blue] = rgb(palette.base00);
  return (0.299 * red + 0.587 * green + 0.114 * blue) / 255 > 0.5;
}

// Zed equivalents of the Neovim highlight groups, as measured in nvim.
function neovimOverrides(palette) {
  const p = palette;
  const bg = p.base00;
  // Ignored/hidden explorer entries: dimmer than text, still readable.
  const subdued = blend(p.base05, bg, 0.55);
  // Visual
  const selection = isLight(p) ? p.base02 : blend(p.base0D, bg, 0.2);

  const style = {
    // LineNr and CursorLineNr
    "editor.line_number": opaque(p.base03),
    "editor.active_line_number": opaque(p.base03),
    // colorcolumn=80,120 (ColorColumn)
    "editor.wrap_guide": opaque(p.base01),
    "editor.active_wrap_guide": opaque(p.base01),
    // listchars (Whitespace)
    "editor.invisible": opaque(p.base01),
    // SnacksIndent / SnacksIndentScope at 40% opacity
    "editor.indent_guide": opaque(blend(p.base01, bg, 0.4)),
    "editor.indent_guide_active": opaque(blend(p.base0C, bg, 0.4)),
    // LspReferenceText/Read/Write
    "editor.document_highlight.read_background": opaque(p.base01),
    "editor.document_highlight.write_background": opaque(p.base01),
    // MatchParen
    "editor.document_highlight.bracket_background": opaque(blend(p.base02, bg, 0.3)),
    // DiffAdd / DiffDelete
    "editor.diff_hunk.added.background": opaque(blend(p.base0B, bg, 0.15)),
    "editor.diff_hunk.deleted.background": opaque(blend(p.base08, bg, 0.15)),
    // WinSeparator
    "pane_group.border": opaque(p.base03),
    // StatusLine
    "status_bar.background": opaque(p.base01),
    // SnacksPickerPathIgnored / SnacksPickerPathHidden
    ignored: opaque(subdued),
    hidden: opaque(subdued),
    // Highlight on yank (IncSearch)
    "vim.yank.background": `${p.base09}80`,
  };
  // Lualine mode section (a): dark text on the mode color.
  for (const [mode, base] of [
    ["normal", "base0D"],
    ["insert", "base0B"],
    ["visual", "base0E"],
    ["visual_line", "base0E"],
    ["visual_block", "base0E"],
    ["replace", "base08"],
  ]) {
    style[`vim.${mode}.background`] = opaque(p[base]);
    style[`vim.${mode}.foreground`] = opaque(bg);
  }

  const syntax = {
    function: { color: opaque(p.base08) },
    namespace: { color: opaque(p.base08) },
    "string.special.symbol": { color: opaque(p.base09) },
    "punctuation.delimiter": { color: opaque(p.base0F) },
    comment: { color: opaque(p.base03), font_style: "italic" },
    hint: { color: opaque(p.base03), font_style: "italic" },
    tag: { color: opaque(p.base0A) },
    attribute: { color: opaque(p.base0A) },
    "variable.special": { color: opaque(p.base05), font_style: "italic" },
    link_text: { color: opaque(p.base09) },
    "text.literal": { color: opaque(p.base09) },
  };
  return { style, syntax, selection };
}

// dict.setdefault
function setdefault(object, key, value) {
  if (!Object.hasOwn(object, key)) object[key] = value;
  return object[key];
}

function buildTheme(source, palette) {
  const theme = JSON.parse(JSON.stringify(source));
  theme.name = THEME_NAME;
  const variants = theme.themes || [];
  if (variants.length === 0) throw new Error("theme file has no themes");
  // tinty generates one theme per file; keep only that one.
  const variant = variants[0];
  variant.name = THEME_NAME;
  theme.themes = [variant];
  if (palette === null) return theme;

  const { style: styleOverrides, syntax: syntaxOverrides, selection } = neovimOverrides(palette);
  const style = setdefault(variant, "style", {});
  Object.assign(style, styleOverrides);
  const syntax = setdefault(style, "syntax", {});
  for (const [capture, highlight] of Object.entries(syntaxOverrides)) {
    syntax[capture] = { ...(syntax[capture] || {}), ...highlight };
  }
  const players = style.players || [];
  if (players.length > 0) players[0].selection = opaque(selection);
  return theme;
}

// Python's json.dumps(indent=2) escapes everything outside printable ASCII.
function dumpJson(value) {
  return JSON.stringify(value, null, 2).replace(
    /[\u007f-\uffff]/g,
    (char) => `\\u${char.charCodeAt(0).toString(16).padStart(4, "0")}`,
  );
}

function writeIfChanged(file, content) {
  try {
    if (readFileSync(file, "utf8") === content) return false;
  } catch (error) {
    if (error.code !== "ENOENT") throw error;
  }
  const dir = path.dirname(file);
  mkdirSync(dir, { recursive: true });
  // Like tempfile.mkstemp: an exclusively created, owner-only file in the same directory.
  let tempName;
  let handle;
  for (;;) {
    tempName = path.join(dir, `.${path.basename(file)}.${randomBytes(4).toString("hex")}.tmp`);
    try {
      handle = openSync(tempName, "wx", 0o600);
      break;
    } catch (error) {
      if (error.code !== "EEXIST") throw error;
    }
  }
  try {
    try {
      writeSync(handle, content);
    } finally {
      closeSync(handle);
    }
    chmodSync(tempName, 0o644);
    renameSync(tempName, file);
  } catch (error) {
    try {
      unlinkSync(tempName);
    } catch {
      // Already gone.
    }
    throw error;
  }
  return true;
}

function isFile(file) {
  try {
    return statSync(file).isFile();
  } catch {
    return false;
  }
}

function main(argv, env) {
  if (argv.length < 2 || !argv[1] || !isFile(argv[1])) return 0;
  let configHome = env.XDG_CONFIG_HOME;
  if (!configHome) {
    if (env.HOME === undefined) throw new Error("HOME is not set");
    configHome = path.join(env.HOME, ".config");
  }
  const themesDir = path.join(configHome, "zed", "themes");

  const source = JSON.parse(readFileSync(argv[1], "utf8"));
  const theme = buildTheme(source, paletteFromEnv(env));
  writeIfChanged(path.join(themesDir, THEME_FILE_NAME), `${dumpJson(theme)}\n`);

  const legacy = path.join(themesDir, LEGACY_THEME_FILE_NAME);
  if (isFile(legacy) && !lstatSync(legacy).isSymbolicLink()) unlinkSync(legacy);
  return 0;
}

process.exitCode = main(process.argv.slice(1), process.env);
