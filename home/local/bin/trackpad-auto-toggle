#!/bin/sh
# Disable the touchpad while a terminal is focused (palm rejection while
# typing) and re-enable it for browsers.
#
# Omarchy 4 notes:
#   - Driven by Hyprland's event socket instead of the old 0.2s poll loop.
#   - `hyprctl keyword "device[...]:enabled"` was removed ("keyword can't work
#     with non-legacy parsers. Use eval."), so this goes through hl.device().
#   - The device name comes from omarchy-hw-touchpad rather than being hardcoded.

for command_name in socat omarchy-hw-touchpad hyprctl; do
  command -v "$command_name" >/dev/null 2>&1 || exit 0
done

DEVICE=$(omarchy-hw-touchpad 2>/dev/null)
[ -n "$DEVICE" ] || exit 0
DEVICE_ESCAPED=$(printf '%s' "$DEVICE" | tr '\n' ' ' | sed 's/\\/\\\\/g; s/"/\\"/g')

SOCKET="${XDG_RUNTIME_DIR:-}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock"
[ -S "$SOCKET" ] || exit 0

# Written by omarchy-toggle-touchpad. When it exists the touchpad was turned
# off by hand, so leave it alone rather than fighting the user.
MANUAL_OFF="$HOME/.local/state/omarchy/toggles/hypr/touchpad-disabled.lua"

state=""

set_touchpad() {
  [ "$state" = "$1" ] && return
  [ -f "$MANUAL_OFF" ] && return
  state="$1"
  hyprctl eval "hl.device({ name = \"$DEVICE_ESCAPED\", enabled = $1 })" >/dev/null 2>&1
}

socat -U - UNIX-CONNECT:"$SOCKET" 2>/dev/null | while IFS= read -r line; do
  case "$line" in
    activewindow'>>'*) ;;
    *) continue ;;
  esac

  class=${line#activewindow>>}
  class=${class%%,*}

  case "$class" in
    # Keep in sync with $OMARCHY_PATH/default/hypr/apps/terminals.lua.
    Alacritty | kitty | com.mitchellh.ghostty | foot | org.codeberg.dnkl.foot | wezterm | org.omarchy.* | TUI.*)
      set_touchpad false
      ;;
    *chrome* | *chromium* | *Chrome* | *Chromium* | *firefox* | *Firefox* | *brave* | *edge* | zen | librewolf | Vivaldi-stable)
      set_touchpad true
      ;;
  esac
done
