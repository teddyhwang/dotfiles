#!/usr/bin/env bash

_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}"
_brew_cache="$_cache_dir/brew_shellenv.sh"
if [[ -x /opt/homebrew/bin/brew ]]; then
  _brew_bin=/opt/homebrew/bin/brew
elif [[ -x /usr/local/bin/brew ]]; then
  _brew_bin=/usr/local/bin/brew
else
  _brew_bin=
fi

if [[ -n "$_brew_bin" ]]; then
  if [[ ! -r "$_brew_cache" ]] || [[ "$_brew_bin" -nt "$_brew_cache" ]]; then
    mkdir -p "$_cache_dir"
    _brew_tmp=$(mktemp "$_cache_dir/brew_shellenv.XXXXXX")
    if "$_brew_bin" shellenv >"$_brew_tmp" 2>/dev/null; then
      mv -f "$_brew_tmp" "$_brew_cache"
    else
      rm -f "$_brew_tmp"
    fi
    unset _brew_tmp
  fi
  [[ -r "$_brew_cache" ]] && . "$_brew_cache"
fi
unset _brew_bin _brew_cache

export EDITOR='nvim'
export FZF_ALT_C_OPTS="--preview='tree -L 1 {}'"
export FZF_CTRL_T_COMMAND="fd --type file --follow --hidden --exclude .git"
export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range :500 {}' --bind 'enter:execute(tmux send-keys \"C-c\" \"Enter\" \"$EDITOR {+}\" \"Enter\")+abort' --multi"
export FZF_DEFAULT_COMMAND="rg --files --hidden"
export FZF_TMUX_OPTS='-p 80%,60%'
export BUN_INSTALL="$HOME/.bun"
export PNPM_HOME="$HOME/.local/share/pnpm"

_path_prepend() {
  [[ -d "$1" ]] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1${PATH:+:$PATH}" ;;
  esac
}

_path_prepend "$HOME/.local/bin"
_path_prepend "$HOME/.local/share/nvim/mason/bin"
_path_prepend "$HOME/go/bin"
_path_prepend "$HOME/.cargo/bin"
_path_prepend "$HOME/.opencode/bin"
_path_prepend "$BUN_INSTALL/bin"
_path_prepend "$PNPM_HOME"
_path_prepend "$HOME/.gem/ruby/4.0.0/bin"
unset -f _path_prepend
export PATH

if [[ -z "${XDG_CONFIG_HOME:-}" ]]; then
  export XDG_CONFIG_HOME="$HOME/.config"
fi

if command -v vivid &>/dev/null; then
  _vivid_bin=$(command -v vivid)
  _vivid_cache="$_cache_dir/vivid_ls_colors"
  if [[ ! -r "$_vivid_cache" ]] || [[ "$_vivid_bin" -nt "$_vivid_cache" ]]; then
    mkdir -p "$_cache_dir"
    _vivid_tmp=$(mktemp "$_cache_dir/vivid_ls_colors.XXXXXX")
    if vivid generate molokai >"$_vivid_tmp" 2>/dev/null; then
      mv -f "$_vivid_tmp" "$_vivid_cache"
    else
      rm -f "$_vivid_tmp"
    fi
    unset _vivid_tmp
  fi
  if [[ -r "$_vivid_cache" ]]; then
    LS_COLORS=$(<"$_vivid_cache")
    export LS_COLORS
  fi
  unset _vivid_bin _vivid_cache
fi

unset _cache_dir
