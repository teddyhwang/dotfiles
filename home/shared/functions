#!/usr/bin/env bash

TINTY_FZF="${XDG_DATA_HOME:-$HOME/.local/share}/tinted-theming/tinty/tinted-fzf-sh-file.sh"

_tinty_load_shell_theme() {
  local script loaded=1
  # An unmatched glob is literal in Bash and an error in Zsh by default.
  # Keep nullglob local to this function; neither path needs a subprocess.
  local data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/tinted-theming/tinty"
  if [[ -n "${ZSH_VERSION:-}" ]]; then
    setopt local_options null_glob
  fi
  for script in "$data_dir"/*.sh; do
    [[ -f "$script" ]] || continue
    . "$script"
    loaded=0
  done
  return "$loaded"
}

tinty_source_shell_theme() {
  command tinty "$@" || return
  case "${1:-}" in
    init | apply) _tinty_load_shell_theme ;;
  esac
}

theme() {
  local selected
  [ -f "$TINTY_FZF" ] && . "$TINTY_FZF"
  selected=$(tinty list | fzf-tmux -p 70%,70% --preview 'tinty info {}')
  if [[ -n "$selected" ]]; then
    tinty_source_shell_theme apply "$selected"
  fi
}

update() {
  tinty update
  if command -v zinit &>/dev/null; then
    zinit update --all
  fi
}

tmux() {
  case ${1:-} in
  start)
    if [[ -z "${2:-}" ]]; then
      echo "Usage: tmux start <session-name>" >&2
      return 2
    fi
    # Build before attaching, and don't assume index 0 (our config starts at 1).
    command tmux new-session -d -s "$2" -n Terminal || return
    command tmux new-window -d -t "=$2:" -n Editor || return
    command tmux new-window -d -t "=$2:" -n Server || return
    command tmux select-window -t "=$2:^" || return
    if [[ -n "${TMUX:-}" ]]; then
      command tmux switch-client -t "=$2"
    else
      command tmux attach-session -t "=$2"
    fi
    ;;
  *)
    command tmux "$@"
    ;;
  esac
}

killport() {
  local port="${1:-}" pids pid
  case "$port" in
  '' | *[!0-9]*)
    echo "Usage: killport <port>" >&2
    return 2
    ;;
  esac
  if ((10#$port < 1 || 10#$port > 65535)); then
    echo "killport: port must be between 1 and 65535" >&2
    return 2
  fi

  pids=$(lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null) || {
    echo "killport: no process is listening on port $port" >&2
    return 1
  }
  while IFS= read -r pid; do
    [[ -n "$pid" ]] && kill -TERM "$pid"
  done <<<"$pids"
}

branch() {
  local selected_branch
  if git rev-parse --git-dir &>/dev/null; then
    selected_branch=$(git for-each-ref --color --sort=-committerdate \
      refs/heads/ \
      --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) | (%(color:green)%(committerdate:relative)%(color:reset)) %(color:bold)%(authorname)%(color:reset) - %(contents:subject)' |
      fzf --ansi |
      cut -f1 -d'|' |
      xargs)

    if [[ -n "$selected_branch" ]]; then
      git checkout "$selected_branch"
    fi
  else
    echo 'ERROR: Not a git repository'
  fi
}

cob() {
  local selected_branch
  if git rev-parse --git-dir &>/dev/null; then
    selected_branch=$(git branch --color --sort=-committerdate \
      --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) | (%(color:green)%(committerdate:relative)%(color:reset)) %(color:bold)%(authorname)%(color:reset) - %(contents:subject)' -r |
      fzf --ansi |
      sed 's|origin/||' |
      cut -f1 -d'|' |
      xargs)

    if [[ -n "$selected_branch" ]]; then
      git checkout "$selected_branch"
    fi
  else
    echo 'ERROR: Not a git repository'
  fi
}

upstream() {
  local current_branch
  current_branch=$(git branch --show-current 2>/dev/null) || return
  if [[ -n "$current_branch" ]]; then
    git branch --set-upstream-to="origin/$current_branch" "$current_branch"
  fi
}

lg() {
  export LAZYGIT_NEW_DIR_FILE=~/.lazygit/newdir

  lazygit "$@"

  if [[ -f "$LAZYGIT_NEW_DIR_FILE" ]]; then
    cd "$(cat "$LAZYGIT_NEW_DIR_FILE")" || return
    rm -f "$LAZYGIT_NEW_DIR_FILE" &>/dev/null
  fi
}

tig() {
  command tig "$@" --pretty=fuller
}

y() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [[ -n "$cwd" ]] && [[ "$cwd" != "$PWD" ]]; then
    builtin cd -- "$cwd" || return
  fi
  rm -f -- "$tmp"
}

how() {
  local input="$*" payload response

  if [[ -f /opt/dev/bin/dev ]]; then
    payload=$(jq -n --arg content "$input" '{
      "model": "expensive-but-best",
      "messages": [
        {"role": "system", "content": "You are a concise cheat sheet. Provide ONLY the shortest possible answer - just the command, key combination, or flag needed. No explanations, no context, no formatting. Just the raw answer. Pay attention to proper case sensitivity (uppercase/lowercase)."},
        {"role": "user", "content": $content}
      ]
    }') || return
    response=$(curl --fail-with-body --silent --show-error \
      --connect-timeout 5 --max-time 60 \
      https://proxy-shopify-ai.local.shop.dev/v1/chat/completions \
      -H "Content-Type: application/json" \
      --data "$payload") || return
    jq -er '.choices[0].message.content' <<<"$response"
  else
    claude -p "$input" --model haiku --append-system-prompt "You are a concise cheat sheet. Provide ONLY the shortest possible answer - just the command, key combination, or flag needed. No explanations, no context, no formatting. Just the raw answer."
  fi
}

if command -v tinty &>/dev/null; then
  case $- in
  *i*)
    if [[ -z "${FLOATERM:-}" && -z "${NVIM:-}" ]]; then
      alias tinty=tinty_source_shell_theme
      # Generated scripts already contain the active theme. No tinty process,
      # find, temporary file, or second cache is needed on warm startup.
      _tinty_load_shell_theme || tinty_source_shell_theme init &>/dev/null
      if [[ -n "${ZSH_VERSION:-}" ]] && typeset -f _tinty &>/dev/null; then
        compdef _tinty tinty tinty_source_shell_theme
      fi
    fi
    ;;
  esac
fi

gwn() {
  if [[ -z "${1:-}" ]]; then
    echo "Usage: gwn <branch-name>" >&2
    return 2
  fi

  local branch base worktree_name worktree_path
  branch="$1"
  base="$(basename "$PWD")"
  worktree_name="${branch//\//-}"
  worktree_path="../${base}--${worktree_name}"

  git worktree add -b "$branch" "$worktree_path" || return
  command -v mise &>/dev/null && mise trust "$worktree_path"
  cd "$worktree_path" || return
}

gwd() {
  local worktree_root primary_worktree current_branch

  worktree_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "gwd: not inside a Git worktree" >&2
    return 1
  }
  primary_worktree=$(git worktree list --porcelain | awk '/^worktree / { sub(/^worktree /, ""); print; exit }')
  if [[ -z "$primary_worktree" || "$worktree_root" == "$primary_worktree" ]]; then
    echo "gwd: refusing to remove the primary worktree" >&2
    return 1
  fi
  current_branch=$(git -C "$worktree_root" branch --show-current)

  local prompt="Remove worktree $worktree_root${current_branch:+ and branch $current_branch}?"
  if command -v gum &>/dev/null; then
    gum confirm "$prompt" || return 0
  else
    local answer
    printf "%s (y/N) " "$prompt"
    IFS= read -r answer || return 0
    case "$answer" in
    [Yy] | [Yy][Ee][Ss]) ;;
    *) return 0 ;;
    esac
  fi

  cd "$primary_worktree" || return
  # Preserve dirty/untracked files and unmerged commits by default. Destructive
  # cleanup, when intended, should use Git's explicit force flags directly.
  git worktree remove -- "$worktree_root" || return
  if [[ -n "$current_branch" ]]; then
    git branch -d -- "$current_branch"
  fi
}

# Inside Herdr, `pi --worktree [name]` never starts pi in this pane. Herdr
# creates the checkout on branch pi-worktree/<name> from this checkout's HEAD,
# opens it as a focused workspace grouped with the repository, and pi starts in
# its pane, in the same subdirectory, with the remaining arguments. An existing
# branch is checked out instead. When that pi exits, the pane asks whether to
# remove the worktree. Resumed sessions and print/JSON/RPC runs keep the
# pi-extensions in-session worktree.
pi() {
  local rc=125
  if [[ "${HERDR_ENV:-}" == 1 ]]; then
    _pi_herdr_worktree "$@"
    rc=$?
  fi
  ((rc == 125)) || return "$rc"
  command pi "$@"
}

# Returns 125 when the call is not a Herdr worktree launch.
_pi_herdr_worktree() {
  local arg name="" requested=0 name_re='^[A-Za-z0-9][A-Za-z0-9._-]*$'
  local prefix head start branch created message pane checkout target command
  local herdr_bin="${HERDR_BIN_PATH:-herdr}"
  local -a args=() base=()
  # Parse --worktree exactly like the extension: an optional name follows
  # unless it looks like a flag or an @file.
  while (($#)); do
    arg=$1
    shift
    case "$arg" in
    --worktree=*)
      requested=1
      name=${arg#--worktree=}
      ;;
    --worktree)
      requested=1
      name=""
      if (($#)) && [[ "$1" != -* && "$1" != @* ]]; then
        name=$1
        shift
      fi
      ;;
    -c | --continue | -r | --resume | --session | --session=* | --session-id | --session-id=* | \
      --fork | --fork=* | -p | --print | --mode | --mode=*)
      return 125
      ;;
    *) args+=("$arg") ;;
    esac
  done
  ((requested)) || return 125
  prefix=$(git rev-parse --show-prefix 2>/dev/null) || return 125

  name=${name:-$(date +%Y%m%d-%H%M%S)-$$}
  branch="pi-worktree/$name"
  if ((${#name} > 100)) || ! [[ "$name" =~ $name_re ]] ||
    ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
    printf 'pi: invalid worktree name: %s\n' "$name" >&2
    return 2
  fi
  if ! git show-ref --verify --quiet "refs/heads/$branch"; then
    head=$(git rev-parse --verify --quiet HEAD) && base=(--base "$head")
  fi
  start=$(git symbolic-ref --short --quiet HEAD || git rev-parse --verify --quiet HEAD)

  if ! created=$("$herdr_bin" worktree create --cwd "$PWD" --branch "$branch" \
    "${base[@]}" --label "$name" --focus 2>&1); then
    message=$(jq -r '.error.message // empty' <<<"$created" 2>/dev/null)
    printf 'pi: Herdr could not create the worktree: %s\n' "${message:-$created}" >&2
    return 1
  fi
  IFS=$'\t' read -r pane checkout < <(jq -r \
    '.result | [.root_pane.pane_id // "", .worktree.path // .root_pane.cwd // ""] | @tsv' <<<"$created")
  if [[ -z "$pane" || -z "$checkout" ]]; then
    printf 'pi: Herdr created the worktree but reported no pane\n' >&2
    return 1
  fi

  target="$checkout${prefix:+/${prefix%/}}"
  [[ -d "$target" ]] || target=$checkout
  command="cd $(printf '%q' "$target") && { pi"
  for arg in "${args[@]}"; do
    command+=" $(printf '%q' "$arg")"
  done
  command+="; _pi_herdr_worktree_close $(printf '%q' "$branch") $(printf '%q' "${start:-HEAD}"); }"
  # A fresh shell reads the command as typeahead, so there is no need to wait.
  if ! "$herdr_bin" pane run "$pane" "$command" >/dev/null; then
    printf 'pi: worktree %s is open in Herdr, but pi could not be started there\n' "$checkout" >&2
    return 1
  fi
  printf 'pi: started in Herdr worktree %s (%s)\n' "$checkout" "$branch"
}

# Runs in the worktree's pane after pi exits and asks before removing the
# worktree. Committed work is never lost: the branch is kept unless it has no
# commits beyond the starting branch, and an unreachable detached HEAD gets a
# safety branch. Removal also closes the worktree's Herdr workspace.
_pi_herdr_worktree_close() {
  local branch=$1 start=$2 root primary changes head ahead answer workspace
  local herdr_bin="${HERDR_BIN_PATH:-herdr}" safety="" delete_branch=0 default="Y/n"
  local details=""
  local -a remove=(worktree remove)
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  primary=$(git worktree list --porcelain | awk '/^worktree / { sub(/^worktree /, ""); print; exit }')
  [[ -n "$primary" && "$root" != "$primary" ]] || return 0

  changes=$(git -C "$root" status --porcelain --untracked-files=normal --ignored=matching) || return 1
  if [[ -n "$changes" ]]; then
    remove+=(--force)
    default="y/N"
    details+=$'\nThese files are deleted:\n'"$(printf '%s\n' "$changes" | head -n 8)"
    (($(printf '%s\n' "$changes" | wc -l) > 8)) && details+=$'\n...'
  fi
  if ! git -C "$root" symbolic-ref --quiet HEAD >/dev/null; then
    head=$(git -C "$root" rev-parse HEAD)
    if [[ -z "$(git for-each-ref --count=1 --contains "$head" refs/heads)" ]]; then
      safety="$branch-detached-${head:0:8}"
      details+=$'\n'"Detached HEAD commits are kept on branch $safety."
    fi
  fi
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    ahead=$(git rev-list --count --right-only --cherry-pick "$start...$branch" 2>/dev/null)
    if [[ "$ahead" == 0 ]]; then
      delete_branch=1
      details+=$'\n'"Branch $branch has no commits beyond $start and is deleted."
    elif [[ -n "$ahead" ]]; then
      details+=$'\n'"Branch $branch is kept with $ahead commit(s) not in $start."
    else
      details+=$'\n'"Branch $branch is kept."
    fi
  fi

  printf '\nRemove worktree %s and close its Herdr workspace?%s\n(%s) ' "$root" "$details" "$default"
  IFS= read -r answer || answer=n
  case "$answer" in
  [Yy] | [Yy][Ee][Ss]) ;;
  "") [[ "$default" == "Y/n" ]] || answer=n ;;
  *) answer=n ;;
  esac
  if [[ "$answer" == n ]]; then
    printf 'Kept %s. Run pi to continue, or remove it with Herdr'\''s remove-worktree action.\n' "$root"
    return 0
  fi

  # Look up the workspace before the checkout disappears.
  workspace=$("$herdr_bin" workspace list 2>/dev/null | jq -r --arg path "$root" \
    'first(.result.workspaces[] | select(.worktree.checkout_path == $path and .worktree.is_linked_worktree) | .workspace_id) // empty')
  cd "$primary" || return 1
  [[ -z "$safety" ]] || git branch "$safety" "$head" || {
    cd "$root" || true
    return 1
  }
  if ! git "${remove[@]}" -- "$root"; then
    cd "$root" || true
    return 1
  fi
  ((delete_branch)) && git branch -D -- "$branch" >/dev/null
  printf 'Removed %s.\n' "$root"
  # Closing the workspace also ends this shell, so it comes last.
  [[ -z "$workspace" ]] || "$herdr_bin" workspace close "$workspace" >/dev/null
}

# Herdr emits no event when a shell changes directory or Git HEAD, so a tab
# named after its repository and branch stays stale until something unrelated
# happens. Ask the tab-autoname plugin to refresh when either changes. The
# check only reads files, so prompts where nothing changed never fork.
_herdr_tab_git_context() {
  local dir="$PWD" git_dir="" line="" head="" zone=""
  while :; do
    if [[ -d "$dir/.git" ]]; then
      git_dir="$dir/.git"
      break
    fi
    if [[ -f "$dir/.git" ]]; then
      # Linked worktrees and submodules point to their Git directory.
      IFS= read -r line 2>/dev/null <"$dir/.git"
      line="${line#gitdir: }"
      [[ "$line" == /* ]] || line="$dir/$line"
      git_dir="$line"
      break
    fi
    if [[ -z "$dir" ]]; then
      _herdr_tab_context="$PWD"
      return 0
    fi
    # A monorepo checkout such as shop/world holds many tec zones. The plugin
    # names tabs and workspaces after the innermost one, so moving between
    # zones must refresh too.
    [[ -z "$zone" && -f "$dir/zone.nix" ]] && zone="$dir"
    dir="${dir%/*}"
  done
  # HEAD names the branch, or holds the commit when detached. It does not
  # change for commands inside the same zone, such as a cd to a subdirectory.
  IFS= read -r head 2>/dev/null <"$git_dir/HEAD"
  _herdr_tab_context="${dir:-/}"$'\n'"$head"$'\n'"$zone"
}

_herdr_tab_autoname_precmd() {
  local last_status=$? herdr_bin="${HERDR_BIN_PATH:-}"
  [[ -S "${HERDR_SOCKET_PATH:-}" ]] || return "$last_status"

  _herdr_tab_git_context
  # The first prompt only records a baseline: pane.created already named it.
  if [[ -n "${_herdr_tab_last_context+x}" &&
    "$_herdr_tab_context" != "$_herdr_tab_last_context" ]]; then
    [[ -x "$herdr_bin" ]] || herdr_bin=herdr
    # The subshell keeps interactive job control from reporting the job.
    ("$herdr_bin" plugin action invoke refresh \
      --plugin teddyhwang.tab-autoname </dev/null >/dev/null 2>&1 &)
  fi
  _herdr_tab_last_context="$_herdr_tab_context"
  return "$last_status"
}

if [[ -n "${HERDR_SOCKET_PATH:-}" ]]; then
  if [[ -n "${ZSH_VERSION:-}" ]]; then
    autoload -Uz add-zsh-hook && add-zsh-hook precmd _herdr_tab_autoname_precmd
  elif [[ -n "${BASH_VERSION:-}" ]]; then
    if [[ -n "${bash_preexec_imported:-}${__bp_imported:-}" ]]; then
      [[ " ${precmd_functions[*]:-} " == *" _herdr_tab_autoname_precmd "* ]] ||
        precmd_functions+=(_herdr_tab_autoname_precmd)
    elif [[ "${PROMPT_COMMAND:-}" != *_herdr_tab_autoname_precmd* ]]; then
      # The hook preserves $?, so prompt commands after it still see the
      # status of the user's last command.
      PROMPT_COMMAND="_herdr_tab_autoname_precmd${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
    fi
  fi
fi
