#!/usr/bin/env bash

[[ -n "${_shared_init_loaded:-}" ]] && return
_shared_init_loaded=1

if [[ -n "$ZSH_VERSION" ]]; then
  _shared_init_cache="${XDG_CACHE_HOME:-$HOME/.cache}/shared_init_cache.zsh"
else
  _shared_init_cache="${XDG_CACHE_HOME:-$HOME/.cache}/shared_init_cache.bash"
fi
_shared_init_regen=0

if [[ ! -f "$_shared_init_cache" ]] || [[ "$HOME/.shared/init" -nt "$_shared_init_cache" ]]; then
  _shared_init_regen=1
elif [[ -n "$ZSH_VERSION" ]]; then
  eval '_stale=( $_shared_init_cache(N.mh+24) )'
  # _stale is assigned by the zsh-only eval above.
  # shellcheck disable=SC2154
  ((${#_stale})) && _shared_init_regen=1
  unset _stale
elif [[ -n "$BASH_VERSION" ]] && [[ $(find "$_shared_init_cache" -mmin +1440 2>/dev/null) ]]; then
  _shared_init_regen=1
fi

_shared_init_regen_cache() (
  # The subshell already isolates these variables. Bash 3.2 unwinds `local`
  # variables before EXIT traps on `exit`, losing cleanup paths on failure.
  _cache="$1" _shell="$2" _tmp="" _piece=""
  _cache_dir=$(dirname "$_cache")
  _cache_name=$(basename "$_cache")
  _lock="${_cache}.lock"

  # Prevent a burst of concurrently-starting shells from all running the same
  # generators. Recover locks and temporary files left by interrupted shells.
  find "$_lock" -prune -mmin +10 -exec rmdir {} \; 2>/dev/null || true
  if ! mkdir "$_lock" 2>/dev/null; then
    # A first-ever shell has no stale cache to use. Wait briefly for the shell
    # holding the lock rather than attempting to source a file mid-rename.
    if [[ ! -f "$_cache" ]]; then
      _attempt=0
      while [[ ! -f "$_cache" && "$_attempt" -lt 200 ]]; do
        sleep 0.05
        _attempt=$((_attempt + 1))
      done
      [[ -f "$_cache" ]] || exit 1
    fi
    exit 0
  fi
  trap '[[ -n "$_tmp" ]] && rm -f "$_tmp"; [[ -n "$_piece" ]] && rm -f "$_piece"; rmdir "$_lock" 2>/dev/null || true' 0
  trap 'exit 1' HUP INT TERM
  find "$_cache_dir" -maxdepth 1 -name "${_cache_name}.tmp.*" -mmin +10 -delete 2>/dev/null || true

  _tmp=$(mktemp "${_cache}.tmp.XXXXXX") || exit 1
  _piece=$(mktemp "${_cache}.tmp.XXXXXX") || exit 1

  # A failed generator may still emit partial (even syntactically valid) shell
  # code. Never publish any of it or replace a last-known-good cache on failure.
  _generate() {
    command -v "$1" &>/dev/null || return 0
    command "$@" >"$_piece" 2>/dev/null || return 1
    cat "$_piece" >>"$_tmp" || return 1
    printf '\n' >>"$_tmp"
  }

  # Several of the generators below are mise shims. A shim that has to install
  # its tool first prints progress on stdout, which lands in the cache and is
  # then sourced as a command by every later shell. Keep mise silent so only
  # the completion/init scripts are captured.
  MISE_QUIET=1 MISE_YES=1
  export MISE_QUIET MISE_YES

  _generate gh completion -s "$_shell" || exit 1
  _generate zoxide init "$_shell" || exit 1
  if [[ "$_shell" == "zsh" ]]; then
    _generate gt completion || exit 1
    _generate carapace _carapace || exit 1
  fi
  _generate tv init "$_shell" || exit 1
  _generate atuin init "$_shell" --disable-up-arrow || exit 1
  _generate tinty generate-completion "$_shell" || exit 1
  _generate shadowenv init "$_shell" || exit 1
  _generate try init || exit 1

  # Parsing must not execute the generated code. Disable startup files in the
  # validation shell so machine-local hooks cannot affect the result.
  if [[ "$_shell" == "zsh" ]]; then
    zsh -f -n "$_tmp" 2>/dev/null || exit 1
  else
    bash --noprofile --norc -n "$_tmp" 2>/dev/null || exit 1
  fi
  mv -f "$_tmp" "$_cache" || exit 1
  _tmp=""
)

if [[ "$_shared_init_regen" == "1" ]]; then
  mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}"
  _shell=
  [[ -n "$ZSH_VERSION" ]] && _shell=zsh || _shell=bash

  if [[ -f "$_shared_init_cache" ]]; then
    # Stale cache exists — use it now, regen in background for next shell
    source "$_shared_init_cache"
    _shared_init_regen_cache "$_shared_init_cache" "$_shell" </dev/null >/dev/null 2>&1 &
    _shared_init_pid=$!
    disown "$_shared_init_pid" 2>/dev/null || true
    unset _shared_init_pid
  else
    # No cache at all — must regen synchronously.
    if _shared_init_regen_cache "$_shared_init_cache" "$_shell"; then
      source "$_shared_init_cache"
    else
      printf 'warning: could not generate shell initialization cache\n' >&2
    fi
  fi
  unset _shell
else
  source "$_shared_init_cache"
fi
unset _shared_init_cache _shared_init_regen

[ -n "$ZSH_VERSION" ] && [ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
return 0
